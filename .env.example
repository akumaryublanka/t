# MikasaVerseBot environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file or share secret values.

BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username_without_at
OWNER_ID=your_telegram_user_id
SUDO_IDS=123456789,987654321
GROUP_ID=-1001234567890
CHARA_CHANNEL_ID=-1001234567890
MONGO_URI=your_mongodb_connection_string
DB_NAME=waifu_bot
SUPPORT_CHAT=your_support_chat_username
UPDATE_CHAT=your_updates_channel_username
PHOTO_URLS=https://example.com/image1.jpg,https://example.com/image2.jpg
DROP_INTERVAL_MINUTES=15
DEFAULT_MSG_FREQUENCY=20

# Optional: Voice Chat Music (Pyrogram + PyTgCalls)
# Create API credentials at https://my.telegram.org
# Generate a session string for a separate Telegram user account.
# Add that assistant account to your group and allow it to manage video chats.
MUSIC_API_ID=
MUSIC_API_HASH=
MUSIC_SESSION_STRING=
